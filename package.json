{
  "name": "product-photojournalism-site",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run verify:harness && npm run verify:apps",
    "verify:harness": "tsc -p scripts/test && eslint --config scripts/test/eslint.config.mjs scripts/test && vitest run --root scripts/test",
    "verify:apps": "node scripts/verify-apps.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "stuck": "node scripts/stuck.mjs",
    "labels": "node scripts/labels.mjs",
    "deploy:add": "node scripts/deploy/add.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
