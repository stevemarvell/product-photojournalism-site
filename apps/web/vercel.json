{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node ../../scripts/deploy/vercel/vercel-ignore.mjs web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://photojournalism-site-api-stevemarvell-team.vercel.app/:path*"
    },
    {
      "source": "/editor/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:id([0-9a-fA-F-]+)",
      "destination": "/index.html"
    }
  ]
}
