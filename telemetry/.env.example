# Copy to .env and set your own values. .env is gitignored: a password in a
# public repository is a password in everyone's hands.
GF_SECURITY_ADMIN_USER=change-me
GF_SECURITY_ADMIN_PASSWORD=change-me

# Optional — only needed for the Grafana Cloud overlay
# (docker compose -f docker-compose.yml -f docker-compose.cloud.yml up -d),
# which forwards local metrics to the same store the GitHub runners use.
#
# Both come from your Grafana Cloud stack's OTLP page. Note the header here is
# the bare value, "Basic <base64>", while the GitHub secret
# GRAFANA_CLOUD_OTLP_AUTH holds "Authorization=Basic <base64>".
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
GRAFANA_CLOUD_AUTH_HEADER=Basic <base64 of instanceID:token>
